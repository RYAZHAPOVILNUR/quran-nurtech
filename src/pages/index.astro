---
import Base from '../layouts/Base.astro';
import { getSurahs } from '../lib/quran';
import { icons } from '../lib/icons';

const surahs = getSurahs();
const quickSurahs = [1, 2, 18, 36, 67].map((n) => surahs.find((s) => s.n === n)).filter(Boolean);
const title = 'Коран онлайн на русском — читать, слушать, изучать';
const description =
  'Читайте Коран онлайн на русском: 114 сур, 6236 аятов. Арабский текст, перевод Кулиева, тафсир ас-Саади, аудио известных чтецов, поиск и закладки.';
---

<Base {title} {description} wide>
  <section class="home-head container">
    <div class="home-copy">
      <p class="eyebrow">quran.nurtech.dev</p>
      <h1 data-i18n="home.title">Коран онлайн</h1>
      <div class="verse">رَبِّ زِدْنِي عِلْمًا</div>
      <p class="verse-tr" data-i18n="home.verse_tr">«Господи! Приумножь мои знания» — сура Та Ха, аят 114</p>
    </div>
    <div class="home-actions">
      <a class="btn primary" href="/surah/1" data-continue-home>
        <span class="ui-inline-icon" set:html={icons.book} /> <span data-i18n="home.start">Начать чтение</span>
      </a>
      <a class="btn" href="/mushaf/1">
        <span class="ui-inline-icon" set:html={icons.book} /> <span data-i18n="home.mushaf">Мусхаф</span>
      </a>
      <a class="btn" href="/search">
        <span class="ui-inline-icon" set:html={icons.search} /> <span data-i18n="home.search">Поиск</span>
      </a>
      <a class="btn" href="/audio">
        <span class="ui-inline-icon" set:html={icons.headphones} /> <span data-i18n="home.audio">Аудио</span>
      </a>
    </div>
  </section>

  <div class="container">
    <section class="quick-surahs" aria-label="Быстрые суры">
      {
        quickSurahs.map((s) => (
          <a class="quick-surah" href={`/surah/${s!.n}`}>
            <span class="quick-surah-num">{s!.n}</span>
            <span>
              <strong>{s!.nr}</strong>
              <small>{s!.nm} · {s!.c} аят.</small>
            </span>
          </a>
        ))
      }
    </section>

    <div class="list-tools">
      <input
        class="filter"
        type="text"
        placeholder="Найти суру по названию или номеру…"
        data-i18n-ph="home.find_surah_ph"
        data-home-filter
        aria-label="Фильтр сур"
      />
    </div>

    <div class="surah-grid" data-surah-grid>
      {
        surahs.map((s) => (
          <div
            class="surah-card"
            data-card
            data-href={`/surah/${s.n}`}
            data-name={`${s.nr} ${s.ne} ${s.nm} ${s.n}`.toLowerCase()}
          >
            <a href={`/surah/${s.n}`} class="num" aria-label={`Сура ${s.n}`}>
              <span>{s.n}</span>
            </a>
            <div class="card-body">
              <div class="row1">
                <a href={`/surah/${s.n}`} class="r">{s.nr}</a>
                <span class="ar-name">{s.na.replace('سُورَةُ ', '')}</span>
              </div>
              <div class="row2">
                <span class="m">{s.nm} · {s.c} аят.</span>
                <span class="acts">
                  <a href={`/surah/${s.n}/kuliev`} aria-label={`Читать суру ${s.nr}`} title="Читать" data-i18n-title="act.read" set:html={icons.book} />
                  <a href={`/audio?s=${s.n}`} aria-label={`Слушать суру ${s.nr}`} title="Слушать" data-i18n-title="act.listen" set:html={icons.headphones} />
                  <a href={`/surah/${s.n}/saadi`} aria-label={`Изучать тафсир суры ${s.nr}`} title="Изучать (тафсир)" data-i18n-title="act.study" set:html={icons.study} />
                </span>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Base>
