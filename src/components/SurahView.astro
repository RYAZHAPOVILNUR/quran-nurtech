---
import { getSurah, getTafsir, getIbnKathir, getSurahMeta, ref } from '../lib/quran';
import { icons } from '../lib/icons';

export type TranslationId = 'kuliev' | 'abuadel' | 'muyassar' | 'saadi' | 'ibn-kathir';
export interface Props {
  surahId: number;
  translation: TranslationId;
  inlineTafsir?: boolean;
}
const { surahId, translation, inlineTafsir = false } = Astro.props;
const surah = getSurah(surahId);
const meta = getSurahMeta(surahId)!;

const isAbuAdel = translation === 'abuadel';
const isMuyassar = translation === 'muyassar';
const isSaadi = translation === 'saadi';
const isIbnKathir = translation === 'ibn-kathir';

// inlineTafsir=true — тафсир под каждым аятом лениво по клику (без «стены текста»):
// это дефолтная страница чтения и режимы Кулиев/Абу Адель. На роутах /saadi и
// /ibn-kathir (inlineTafsir=false) тафсир печатается сплошняком — полное чтение.
const showTafsirToggle = inlineTafsir;
const showSaadiWall = isSaadi && !inlineTafsir;
const showIkWall = isIbnKathir && !inlineTafsir;

const tafsir = showSaadiWall ? getTafsir(surahId) : []; // ас-Саади по аятам
const ik = showIkWall ? getIbnKathir(surahId) : []; // Ибн Касир по аятам
const blockFor = (a: number) => tafsir.find((b) => b.a === a);
const ikFor = (a: number) => ik.find((b) => b.a === a);

// границы джузов и страниц мусхафа в этой суре (маркеры навигации)
let _pj: number | null = null;
let _pp: number | null = null;
const juzAt: Record<number, number> = {};
const pageAt: Record<number, number> = {};
for (const a of surah.a) {
  if (a.j && a.j !== _pj) {
    juzAt[a.n] = a.j;
    _pj = a.j;
  }
  if (a.p && a.p !== _pp) {
    pageAt[a.n] = a.p;
    _pp = a.p;
  }
}

const labels: Record<TranslationId, string> = {
  kuliev: 'Перевод Кулиева',
  abuadel: 'Перевод Абу Аделя',
  muyassar: 'التفسير الميسر (арабский)',
  saadi: 'Тафсир ас-Саади',
  'ibn-kathir': 'Тафсир Ибн Касира',
};
const isMecca = meta.t === 'мекканская';
const prevN = surahId > 1 ? surahId - 1 : null;
const nextN = surahId < 114 ? surahId + 1 : null;
const arName = surah.na.replace('سُورَةُ ', '');
---

<div class="container">
  <nav class="crumb">
    <a href="/" data-i18n="reader.home">Главная</a><span>›</span><span><span data-i18n="reader.surah_word">Сура</span> {surah.n}</span><span>›</span>
    <span>{surah.nr}</span>
  </nav>

  <header class="surah-head">
    <div class="kicker"><span data-i18n="reader.surah_no">Сура №</span>{surah.n} · {surah.nm}</div>
    <h1>{surah.nr}</h1>
    <div class="ar">{arName}</div>
    <div class="meta">
      <span class={`chip ${isMecca ? 'mecca' : 'medina'}`}>{meta.t}</span>
      <span class="chip">{surah.c} <span data-i18n="reader.ayahs_word">аятов</span></span>
      <span class="chip">{labels[translation]}</span>
    </div>
  </header>

  <details class="surah-desc">
    <summary data-i18n="reader.surah_desc_summary">Описание суры и режима чтения</summary>
    <p>
      <strong>{surah.nr}</strong> ({surah.nm}) — {meta.t} сура Корана под номером {surah.n},
      состоит из {surah.c} аятов. Ниже приведён арабский текст (Усмани) и {labels[translation].toLowerCase()}.
      Перевод, чтец, размер шрифта и тему можно изменить в верхней панели.
    </p>
  </details>

  <div
    class="ayahs"
    data-ayahs
    data-view="all"
    data-primary={isMuyassar ? 'muyassar' : isAbuAdel ? 'abuadel' : 'kuliev'}
    data-surah-name={surah.nr}
  >
    {surah.bism && <div class="bism">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</div>}

    {
      surah.a.map((ayah) => {
        const saadiBlk = showSaadiWall ? blockFor(ayah.n) : undefined;
        const ikBlk = showIkWall ? ikFor(ayah.n) : undefined;
        return (
          <>
            {juzAt[ayah.n] && (
              <div class="juz-sep" id={`juz-${juzAt[ayah.n]}`}>
                <span><span data-i18n="reader.juz_word">Джуз</span> {juzAt[ayah.n]}</span>
              </div>
            )}
            {pageAt[ayah.n] && !juzAt[ayah.n] && (
              <div class="page-sep"><span data-i18n="reader.page_word">Страница</span> {pageAt[ayah.n]}</div>
            )}
            <article class="ayah" id={`ayah-${ayah.n}`} data-ayah-key={ref(surah.n, ayah.n)}>
              <div class="ayah-top">
                <a class="ayah-no" href={`/${surah.n}:${ayah.n}`} title="Открыть аят" data-i18n-title="reader.open_ayah_title">{surah.n}:{ayah.n}</a>
                <div class="ayah-acts">
                  <button type="button" data-act="play" aria-label="Слушать аят" title="Слушать" data-i18n-title="reader.play_title" set:html={icons.play} />
                  <button type="button" data-bm={ref(surah.n, ayah.n)} aria-label="В закладки" title="Закладка" data-i18n-title="reader.bookmark_title" set:html={icons.bookmark} />
                  <button class="secondary-action" type="button" data-act="copy" aria-label="Копировать" title="Копировать" data-i18n-title="reader.copy_title" set:html={icons.copy} />
                  <button class="secondary-action" type="button" data-act="share" aria-label="Поделиться" title="Поделиться" data-i18n-title="reader.share_title" set:html={icons.share} />
                  <a href={`/${surah.n}:${ayah.n}`} aria-label="Открыть аят" title="Открыть аят" data-i18n-title="reader.open_ayah_title" set:html={icons.details} />
                </div>
              </div>
              <div class="ar" set:html={ayah.ar} />
              {ayah.tl && <div class="translit">{ayah.tl}</div>}
              <div class="tr-block">
                {isMuyassar ? (
                  ayah.mu && (
                    <div class="translation tr-muyassar" dir="rtl" lang="ar">
                      <span class="tr-lbl">التفسير الميسر</span>{ayah.mu}
                    </div>
                  )
                ) : (
                  <>
                    <div class="translation tr-kuliev"><span class="tr-lbl" data-i18n="reader.lbl_kuliev">Кулиев</span>{ayah.ru}</div>
                    {ayah.aa && (
                      <div class="translation tr-abuadel"><span class="tr-lbl" data-i18n="reader.lbl_abuadel">Абу Адель</span>{ayah.aa}</div>
                    )}
                  </>
                )}
              </div>
              {showTafsirToggle && (
                <div class="tafsir-toggles">
                  <button class="tafsir-toggle" type="button" data-act="tafsir" data-src="saadi" aria-expanded="false" title="Тафсир ас-Саади" data-i18n-title="reader.tafsir_saadi">
                    <span class="tt-ic" set:html={icons.book} />
                    <span class="tt-tx" data-i18n="reader.tafsir_saadi">Тафсир ас-Саади</span>
                    <span class="tt-caret" set:html={icons.chevron} />
                  </button>
                  <button class="tafsir-toggle" type="button" data-act="tafsir" data-src="ik" aria-expanded="false" title="Тафсир Ибн Касира" data-i18n-title="reader.tafsir_ibnkathir">
                    <span class="tt-ic" set:html={icons.book} />
                    <span class="tt-tx" data-i18n="reader.tafsir_ibnkathir">Тафсир Ибн Касира</span>
                    <span class="tt-caret" set:html={icons.chevron} />
                  </button>
                </div>
              )}
              {saadiBlk && (
                <div class="tafsir-passage">
                  <span class="tafsir-label"><span data-i18n="reader.tafsir_saadi_ayah">Тафсир ас-Саади · аят</span> {surah.n}:{ayah.n}</span>
                  <div class="tafsir">{saadiBlk.x}</div>
                </div>
              )}
              {ikBlk && (
                <details class="tafsir-details">
                  <summary><span data-i18n="reader.tafsir_ibnkathir_ayah">Тафсир Ибн Касира · аят</span> {surah.n}:{ayah.n}</summary>
                  <div class="tafsir">{ikBlk.x}</div>
                </details>
              )}
            </article>
          </>
        );
      })
    }
  </div>

  <nav class="ayah-nav">
    {prevN ? (
      <a class="btn" href={`/surah/${prevN}`}>
        <span class="ui-inline-icon-sm" set:html={icons.arrowLeft} /> <span data-i18n="reader.prev_surah">Пред. сура</span>
      </a>
    ) : (
      <span />
    )}
    {nextN && (
      <a class="btn" href={`/surah/${nextN}`}>
        <span data-i18n="reader.next_surah">След. сура</span> <span class="ui-inline-icon-sm" set:html={icons.arrowRight} />
      </a>
    )}
  </nav>
</div>

<script>
  import '../client/reader-extras';
</script>
