---
// Глобальный переключатель ЛОКАЛИ интерфейса (виден на всех страницах).
// Русский (LTR) ↔ العربية (RTL, весь интерфейс + смысл аятов на арабском).
// Обработчик — client/i18n.ts (initLocaleSwitch).
import { icons } from '../../lib/icons';
---

<div class="menu-wrap lang-switch" data-menu-wrap>
  <button class="icon-btn lang-btn" data-menu-toggle aria-haspopup="true" aria-label="Язык интерфейса / اللغة" title="Язык / اللغة" data-i18n-title="lang.title">
    <span class="ui-inline-icon-xs" set:html={icons.globe} />
    <span class="lang-cur" data-lang-current>RU</span>
  </button>
  <div class="menu menu-lang" data-menu="lang">
    <h4 data-i18n="lang.title">Язык</h4>
    <button class="item" type="button" data-locale-set="ru">
      Русский
      <span class="tick">✓</span>
    </button>
    <button class="item lang-ar" type="button" data-locale-set="ar" dir="rtl" lang="ar">
      العربية
      <span class="tick">✓</span>
    </button>
  </div>
</div>

<style is:global>
  .lang-switch .lang-btn {
    width: auto;
    min-width: 0;
    gap: 5px;
    padding-inline: 9px;
    font: 600 12.5px/1 var(--sans);
  }
  .lang-switch .lang-cur {
    letter-spacing: 0.02em;
  }
  .menu-lang {
    min-width: 180px;
  }
  .menu-lang .lang-ar {
    direction: rtl;
    text-align: right;
    font-family: var(--font-arabic-ui);
    font-size: 15px;
  }
</style>
