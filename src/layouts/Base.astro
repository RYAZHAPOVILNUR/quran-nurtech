import '../styles/mushaf-qcf.css';
import '../styles/mushaf-reader.css';
import '../styles/mushaf-zoom.css';
import '../styles/mushaf-immersive.css';
import '../styles/mushaf-responsive.css';
import '../styles/rtl.css';
import TopBar from '../components/TopBar.astro';
import Drawer from '../components/Drawer.astro';
import Player from '../components/Player.astro';
import { icons } from '../lib/icons';
import { getMushafHrefForPath } from '../lib/mushaf-link';

export interface Props {
  title: string;
  description?: string;
  wide?: boolean;
  pageMode?: string;
  /** для страниц суры/аята — чтобы плеер знал контекст */
  surahId?: number;
  ayahId?: number;
  tr?: string;
}

const { title, description, wide = false, pageMode, surahId, ayahId, tr } = Astro.props;
const desc =
  description ??
  'Коран онлайн на русском языке: чтение, перевод, тафсир ас-Саади, аудио чтецов, поиск и заучивание. 114 сур, 6236 аятов.';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname;
const mushafHref = getMushafHrefForPath(path);
const tab = (name: 'home' | 'read' | 'mushaf' | 'search') => {
  if (name === 'home') return path === '/' ? 'active' : '';
  if (name === 'read') return path.startsWith('/surah') || path.startsWith('/ayah') || /^\/\d+:\d+/.test(path) ? 'active' : '';
  if (name === 'mushaf') return path.startsWith('/mushaf') ? 'active' : '';
  if (name === 'search') return path.startsWith('/search') ? 'active' : '';
  return '';
};
---

<!doctype html>
<html lang="ru" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Коран онлайн" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#3f4a58" />
    <link rel="icon" href="/favicon.png?v=g2" type="image/png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=g2" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Коран" />
    <link rel="preload" href="/fonts/kfgqpc-hafs.woff2" as="font" type="font/woff2" crossorigin />
    <!-- анти-flash: тема и настройки чтения до первой отрисовки -->
    <script is:inline>
      (function () {
        try {
          var raw = localStorage.getItem('q_theme');
          var t = 'system';
          if (raw) {
            try {
              t = JSON.parse(raw);
            } catch (e) {
              t = raw;
            }
          }
          var eff = t;
          if (t === 'system')
            eff = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', eff);
          var r = JSON.parse(localStorage.getItem('q_read') || '{}');
          var el = document.documentElement.style;
          if (r.ar) el.setProperty('--ar-size', r.ar + 'px');
          if (r.ru) el.setProperty('--ru-size', r.ru + 'px');
          if (r.lh) el.setProperty('--lh', r.lh);
          if (r.font) el.setProperty('--ar-font', r.font);
          var sidebar = localStorage.getItem('q_sidebar');
          if (sidebar === 'closed' || sidebar === 'open')
            document.documentElement.setAttribute('data-sidebar', sidebar);
          var loc = 'ru';
          try {
            loc = JSON.parse(localStorage.getItem('q_locale') || '"ru"');
          } catch (e) {}
          if (loc === 'ar') {
            document.documentElement.setAttribute('lang', 'ar');
            document.documentElement.setAttribute('dir', 'rtl');
            document.documentElement.setAttribute('data-locale', 'ar');
          }
        } catch (e) {}
      })();
    </script>
    <!-- PWA: офлайн-доступ -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        addEventListener('load', function () {
          var host = location.hostname;
          if (host === 'localhost' || host === '127.0.0.1' || host === '[::1]') {
            navigator.serviceWorker.getRegistrations().then(function (items) {
              items.forEach(function (item) {
                item.unregister();
              });
            });
            return;
          }
          navigator.serviceWorker.register('/sw.js?v=drawer-tabs-macos-20260715').catch(function () {});
        });
      }
    </script>
  </head>
  <body data-surah={surahId ?? ''} data-ayah={ayahId ?? ''} data-tr={tr ?? ''} data-page-mode={pageMode ?? ''}>
    <TopBar />
    <main role="main" class={wide ? 'wide' : ''}>
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <div class="fnav">
          <a href="/" data-i18n="tab.home">Главная</a>
          <a href={mushafHref} data-i18n="nav.mushaf">Мусхаф</a>
          <a href="/progress" data-i18n="nav.progress">Мой прогресс</a>
          <a href="/bookmarks" data-i18n="nav.bookmarks">Закладки</a>
          <a href="/topics" data-i18n="nav.topics">Аяты по темам</a>
          <a href="/glossary" data-i18n="foot.glossary">Словарь</a>
          <a href="/tasbih" data-i18n="nav.tasbih">Тасбих</a>
          <a href="/backup" data-i18n="nav.backup">Резервная копия</a>
          <a href="/search" data-i18n="tab.search">Поиск</a>
          <a href="/audio" data-i18n="home.audio">Аудио</a>
          <a href="/videos" data-i18n="foot.videos">Видео</a>
          <a href="/stats" data-i18n="foot.stats">Статистика</a>
          <a href="/download" data-i18n="foot.download">Скачать</a>
          <a href="/howto" data-i18n="foot.howto">Как работать</a>
          <a href="/about" data-i18n="nav.about">О проекте</a>
          <a href="/translators" data-i18n="foot.translators">Переводчики</a>
          <a href="/privacy" data-i18n="foot.privacy">Конфиденциальность</a>
        </div>
        <div data-i18n="foot.note">
          Коран онлайн — quran.nurtech.dev. Тексты и аудио из открытых источников.
        </div>
      </div>
    </footer>

    <Drawer />
    <Player />
    <nav class="mobile-tabbar" aria-label="Основная навигация">
      <a class={tab('home')} href="/" aria-label="Главная">
        <span set:html={icons.home}></span>
        <b data-i18n="tab.home">Главная</b>
      </a>
      <a class={tab('read')} href="/surah/1" aria-label="Читать">
        <span set:html={icons.book}></span>
        <b data-i18n="tab.read">Читать</b>
      </a>
      <a class={tab('mushaf')} href={mushafHref} aria-label="Мусхаф">
        <span set:html={icons.book}></span>
        <b data-i18n="tab.mushaf">Мусхаф</b>
      </a>
      <a class={tab('search')} href="/search" aria-label="Поиск">
        <span set:html={icons.search}></span>
        <b data-i18n="tab.search">Поиск</b>
      </a>
      <button type="button" data-act="drawer" aria-label="Меню">
        <span set:html={icons.menu}></span>
        <b data-i18n="tab.menu">Меню</b>
      </button>
    </nav>
    <div class="toast" id="toast"></div>

    <script>
      import '../client/app';
      import '../client/i18n';
    </script>
  </body>
</html>
